# ──────────────────────────────────────────────────────────────
# 전북소방 구조 AI 챗봇 — 환경변수 템플릿
# 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 커밋되지 않습니다)
# 운영 클라우드로 이전할 때는 이 값들만 교체하면 됩니다.
# ──────────────────────────────────────────────────────────────

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_public_key...
# 서버 전용. 절대 클라이언트에 노출 금지. (인덱서 / 관리자 통계 집계에만 사용)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# --- Anthropic Claude (서버 전용) ---
ANTHROPIC_API_KEY=sk-ant-...
# 모델 ID. 정확한 dated 버전이 있으면 교체하세요. (예: claude-sonnet-4-5-YYYYMMDD)
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- 임베딩 제공자 (openai | bge) ---
# 웹앱의 쿼리 임베딩과 Python 인덱서는 반드시 같은 설정을 사용해야 합니다.
EMBEDDING_PROVIDER=openai

# openai 사용 시 (기본): text-embedding-3-small 을 1024차원으로 사용 (스키마 vector(1024)와 일치)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# bge 사용 시: 자체 호스팅 BGE-M3 임베딩 서비스 URL (indexing/serve.py 참고)
# EMBEDDING_PROVIDER=bge 일 때만 필요. /embed 엔드포인트가 {"texts":[...]} -> {"embeddings":[[...1024...]]} 형태를 반환해야 함.
EMBEDDING_API_URL=http://localhost:8000

# --- 사이트 URL (매직링크 리다이렉트 / auth 콜백) ---
# 로컬: http://localhost:3000 / 배포: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 퀴즈 정답키 암호화 비밀 (서버 전용, 선택) ---
# 설정 안 하면 SUPABASE_SERVICE_ROLE_KEY 로 대체합니다. 운영에서는 별도 랜덤값 권장.
# 예: openssl rand -base64 32
QUIZ_SECRET=
