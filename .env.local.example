# ──────────────────────────────────────────────────────────────
# 전북소방 구조 교육훈련 플랫폼 — 환경변수 템플릿
# 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 커밋되지 않습니다)
# 운영 클라우드/내부망으로 이전할 때는 이 값들만 교체하면 됩니다.
# ──────────────────────────────────────────────────────────────

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_public_key...
# 서버 전용. 절대 클라이언트에 노출 금지. (인덱서 / 관리자 통계 집계에만 사용)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# --- LLM 제공자 (claude | gemini | openai-compat) — 챗봇·AI 자료제작 공용 ---
LLM_PROVIDER=claude

# claude 사용 시
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# gemini 사용 시 (+ 임베딩 기본값 EMBEDDING_PROVIDER=google 도 이 키를 사용)
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# openai-compat 사용 시 (내부망 Qwen·Ollama /v1·vLLM 등 OpenAI 호환 서버)
# LLM_API_URL=http://10.x.x.x:11434/v1
# LLM_MODEL=qwen3.5
# LLM_API_KEY=             # 서버가 요구할 때만
# GLM_MODEL=glm-4.6        # openai-compat 슬롯에 GLM(z.ai) 쓸 때 모델명 (기본 glm-4.6)

# --- 검색 재순위·질의확장 (선택) ---
# rag_2026 하이브리드 검색(벡터+키워드 RRF)은 항상 켜짐. 그 위에 LLM 재순위 추가 적용.
# 너무 느리면 RERANK=0 으로 끄면 됨(하이브리드만 사용). 기본 켜짐.
# RERANK=0
# QUERY_EXPANSION=0        # 질의확장(LLM 동의어 확장) 끄기. 기본 켜짐.

# --- 데모 모드 (선택) ---
# 1 이면 Supabase/LLM 키 없이 목 데이터로 전체 UI 시연. 기본 0.
NEXT_PUBLIC_DEMO_MODE=0

# --- Vercel Cron 인증 (선택) ---
# 뉴스 자동수집(/api/news/refresh) 크론 호출 인증용 시크릿. 설정 시 관리자 외 크론도 허용.
# CRON_SECRET=

# --- RAG 데이터 출처 (선택) ---
# 기본: 자체 스키마(documents/chunks + hybrid_search).
# 외부에서 임베딩해 둔 LangChain 형식 테이블을 쓰려면 지정 (예: rag_2026 — match_rag_2026 RPC 필요)
# RAG_TABLE=rag_2026

# --- 임베딩 제공자 (auto | google | openai | bge | ollama) ---
# 쿼리 임베딩(웹앱)과 적재(rag7.py) 임베딩은 반드시 같은 제공자/모델/차원을 써야 합니다.
# auto: Ollama를 사용. 장애 시 다른 벡터 공간인 Google로 바꾸지 않습니다.
#   외부 RAG 웹 검색은 Ollama 장애/계약 불일치 시 키워드 검색만 사용하고,
#   rag7.py는 코퍼스 오염을 막기 위해 적재를 중단합니다.
EMBEDDING_PROVIDER=google
# 임베딩 전처리/태스크 규약 버전. 특별한 이전 작업이 아니면 기본값을 사용하세요.
# EMBEDDING_VERSION=

# google 사용 시 (기본): gemini-embedding-001 을 1024차원(MRL 절단)으로 → 스키마 vector(1024)와 일치.
#   키는 위 GOOGLE_GENERATIVE_AI_API_KEY 를 그대로 재사용합니다(Gemini 챗과 공용).
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# openai 사용 시: text-embedding-3-small 을 1024차원으로 (스키마 vector(1024)와 일치)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# bge 사용 시: 자체 호스팅 서비스 (indexing/serve.py 형식: POST /embed {"texts":[...]})
# EMBEDDING_API_URL=http://localhost:8000
# BGE_EMBEDDING_MODEL=BAAI/bge-m3

# ollama 사용 시: 홈서버 등 Ollama (POST /api/embed, 모델 예: bge-m3)
# EMBEDDING_API_URL=http://192.168.0.10:11434
# 모델 태그까지 DB 계약에 포함되므로 인덱서와 웹앱에서 정확히 같아야 합니다.
# EMBEDDING_MODEL=bge-m3:latest

# --- 적재기(rag7.py) 문서 변환 OCR ---
# 기본 auto: PDF 페이지별 텍스트층을 확인하고 저텍스트 페이지가 하나라도 있으면
# 한국어/영어 EasyOCR을 켭니다. 강제하려면 1(항상 켬) 또는 0(항상 끔).
# DOCLING_OCR=auto
# DOCLING_OCR_LANGS=ko,en
# DOCLING_TEXT_PAGE_RATIO=1.0
# DOCLING_MIN_TEXT_CHARS_PER_PAGE=40
# 인터넷 연결 환경에서는 OCR 모델을 자동 다운로드합니다.
# 내부망에서는 모델을 미리 반입한 뒤 0으로 설정하세요.
# DOCLING_OCR_DOWNLOAD=1

# --- 적재기(rag7.py) 파일·자료실 연결 ---
# HWPX/HWP는 LibreOffice로 임시 PDF 변환 후 파싱·자료실 등록합니다.
# macOS 기본 경로는 자동 탐지하며, 다른 위치라면 실행 파일을 지정하세요.
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
# RAG_CONVERSION_TIMEOUT_SECONDS=180
# RAG_MAX_FILE_MB=200

# --- 한글(hwpx) 작성 API (선택 — 미니서버 hwp-writer-api) ---
# 설정하면 /generate 의 한글 다운로드가 미니서버(python-hwpx)로 정식 hwpx 를 생성.
# 미설정/장애 시 자동으로 브라우저 로컬 생성(lib/hwpx.ts)으로 폴백하므로 없어도 동작함.
# 로컬 개발: Tailscale IP 가능 / Vercel 배포: 터널(HTTPS) 주소 필요 — Tailscale IP 는 Vercel 에서 접근 불가.
# HWP_WRITER_API_URL=http://192.168.0.10:8010
# HWP_WRITER_API_KEY=...

# --- 사이트 URL (매직링크 리다이렉트 / auth 콜백) ---
# 로컬: http://localhost:3000 / 배포: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
