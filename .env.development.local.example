# 별도 개발 프로젝트 또는 로컬 Supabase 전용 설정입니다.
# .env.development.local로 복사하고 개발 DB 값만 입력하세요.
# 원격 개발 프로젝트 ref는 config/database-environments.json에도 등록합니다.
# npm run dev/build/start는 이 파일을 사용하며 운영 .env.local 키로 폴백하지 않습니다.
RESCUEAI_DATABASE_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://DEVELOPMENT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=0
RAG_TABLE=rag_rescue
LLM_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_VERSION=google-retrieval-v1
# 선택 기능을 사용하지 않으면 빈 값으로 둡니다.
HWP_WRITER_API_URL=
HWP_WRITER_API_KEY=
